# SSDI Agent environment
# Copy this file to .env. Never commit real credentials.

# Required: Anvil PDF filling and generation
ANVIL_API_KEY=
ANVIL_EID_SSA16=
ANVIL_EID_SSA3368=
ANVIL_EID_SSA3369=
ANVIL_EID_SSA827=

# Required: Anthropic (Claude) structured fact extraction and Windows planning
# Create a key at console.anthropic.com.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Required: outbound provider calls via the Guava agent
# Guava dials over a persistent websocket held open by the Python agent, so the
# web app posts to the local shim (agent/serve.py) instead of a REST endpoint.
SSDI_SHIM_URL=http://127.0.0.1:8787/call
# Shared secret. When the shim has SSDI_SHIM_TOKEN set, callers must send the
# same value in the X-SSDI-Token header. Leave blank to disable the check.
SSDI_SHIM_TOKEN=
# The Guava number the agent dials from, in E.164.
SSDI_AGENT_NUMBER=
# Shared secret for verifying inbound agent webhooks.
SSDI_WEBHOOK_SECRET=

# Required: Guava browser voice session (speech-to-text AND text-to-speech)
# The server mints a short-lived WebRTC code at /api/voice/session.
# This key is server-only and never reaches the browser.
GUAVA_API_KEY=

# Optional: reuse a permanent WebRTC code from the Guava dashboard or
# `guava widget` instead of minting one per session.
GUAVA_WEBRTC_CODE=
# Optional: TTL in seconds for minted codes (default 3600).
GUAVA_WEBRTC_TTL_SECONDS=
# Optional overrides for staging or self-hosted Guava endpoints.
GUAVA_API_BASE_URL=https://api.goguava.ai
NEXT_PUBLIC_GUAVA_APP_URL=https://app.goguava.ai

# Program configuration
SGA_MONTHLY_LIMIT_NONBLIND_USD=1690
SGA_MONTHLY_LIMIT_BLIND_USD=2830
EARNINGS_PER_CREDIT_USD=1890
EARNINGS_FOR_FOUR_CREDITS_USD=7560
HIPAA_ACCESS_DEADLINE_DAYS=30
HIPAA_EXTENSION_DAYS=30
SSA827_VALIDITY_MONTHS=12
TRACKER_NUDGE_DAY=20
TRACKER_ESCALATE_DAY=30

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
