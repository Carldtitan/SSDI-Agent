{
  "name": "ssdi-agent",
  "version": "0.1.0",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "desktop": "electron desktop/main.cjs",
    "desktop:dev": "electron desktop/main.cjs --url=http://localhost:3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "inspect:anvil": "tsx --env-file=.env scripts/inspect-anvil-schema.ts",
    "verify:packet:live": "tsx --env-file=.env scripts/verify-packet-live.ts",
    "verify:windows-control": "electron scripts/verify-windows-control.cjs",
    "design:detect": "node skills/impeccable/scripts/detect.mjs --json app components"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@anvilco/anvil": "latest",
    "@radix-ui/react-dialog": "latest",
    "@radix-ui/react-progress": "latest",
    "@radix-ui/react-slot": "latest",
    "clsx": "latest",
    "fflate": "^0.8.3",
    "lucide-react": "latest",
    "motion": "latest",
    "next": "latest",
    "ogl": "^1.0.11",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "postcss": "8.5.18",
    "react": "latest",
    "react-dom": "latest",
    "server-only": "^0.0.1",
    "sharp": "0.35.0",
    "tailwind-merge": "latest",
    "tesseract.js": "^7.0.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "electron": "^43.2.0",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "fast-check": "latest",
    "jsdom": "29.1.1",
    "tailwindcss": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "overrides": {
    "postcss": "8.5.18",
    "sharp": "0.35.0"
